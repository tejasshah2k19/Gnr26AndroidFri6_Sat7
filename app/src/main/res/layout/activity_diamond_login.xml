<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".diamond_game.DiamondLoginActivity"
    android:background="@color/bg_activity"
    >


    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:id="@+id/imgDiamondLoginLogo"
        android:src="@drawable/diamond_hmt_512"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="120dp"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tvDiamondLoginTitle"
        android:text="Login"
        android:textSize="15pt"
        android:textColor="#0B0A0A"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/imgDiamondLoginLogo"
        android:layout_marginTop="20dp"
        />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/edtDiamondLoginEmail"
        android:layout_below="@id/tvDiamondLoginTitle"
        android:layout_marginTop="50dp"
        android:hint="Email"
        android:drawableStart="@drawable/mail"
        android:drawablePadding="20dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/edtDiamondLoginPassword"
        android:layout_below="@id/edtDiamondLoginEmail"
        android:layout_marginTop="20dp"
        android:hint="Password"
        android:inputType="textPassword"
        android:drawableStart="@drawable/lock"
        android:drawablePadding="20dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"

        />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/btnDiamondLoginSubmit"
        android:text="Submit"
        android:layout_below="@id/edtDiamondLoginPassword"
        android:layout_marginTop="50dp"
        android:layout_centerHorizontal="true"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tvDiamondLoginSignupLink"
        android:text="@string/new_user"
        android:layout_below="@id/btnDiamondLoginSubmit"
        android:textSize="8pt"
        android:textColor="#BA255F"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        />

</RelativeLayout>